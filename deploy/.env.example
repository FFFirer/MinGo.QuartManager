# =============================================================================
# MinGo.QuartManager 生产环境变量配置
# 复制为 .env 并填入实际值
# =============================================================================

# --- Docker Registry ---
REGISTRY=registry.example.com
IMAGE_NAME=1mingo/quartmanager
IMAGE_TAG=latest

# --- 数据库 (PostgreSQL) ---
DB_CONNECTION_STRING=Host=db.example.com;Database=MinGoQap;Username=qap;Password=CHANGE_ME;Port=5432

# --- 认证 ---
# 可选值: None, JWT, OIDC
AUTH_TYPE=None

# --- Heartbeat 超时 (秒) ---
HEARTBEAT_WARNING=60
HEARTBEAT_OFFLINE=90

# --- Agent 部署 (deploy/agent/ 使用) ---
PLATFORM_URL=http://platform:80
CLUSTER_ID=default
LOG_LEVEL=Information
AGENT_PORT=8080

# --- PostgreSQL (Agent 集群模式, deploy/agent/ 使用) ---
POSTGRES_PASSWORD=CHANGE_ME

# --- OpenTelemetry (可选) ---
# 设置 OTLP 端点以启用 traces/metrics/logs 导出
# 示例: http://otel-collector:4317 (gRPC)
OTEL_OTLP_ENDPOINT=
