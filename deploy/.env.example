# =============================================================================
# MinGo.QuartManager 部署环境变量
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env
# =============================================================================

# --- Docker Registry ---
REGISTRY=registry.example.com
IMAGE_NAME=1mingo/quartmanager
IMAGE_TAG=latest

# --- 数据库 ---
DB_CONNECTION_STRING=Host=postgres.example.com;Port=5432;Database=quartmanager;Username=postgres;Password=YOUR_PASSWORD

# --- 认证 (可选，None=无认证) ---
AUTH_TYPE=None

# --- Heartbeat 超时 (秒) ---
HEARTBEAT_WARNING=60
HEARTBEAT_OFFLINE=90
