{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Properties": {
      "Application": "MinGo.Qap.Platform"
    }
  },
  "OpenTelemetry": {
