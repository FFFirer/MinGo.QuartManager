<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    
    <!-- NuGet Package Metadata -->
    <PackageId>MinGo.Qap.Agent</PackageId>
    <Version>1.0.0</Version>
    <Authors>MinGo Team</Authors>
    <Description>Quartz.NET Agent library for MinGo Platform - provides job discovery, scheduling, and logging capabilities</Description>
    <Readme>README.md</Readme>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinGo.Qap.Shared\MinGo.Qap.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Quartz" Version="3.17.1" />
    <PackageReference Include="Quartz.Extensions.DependencyInjection" Version="3.17.1" />
    <PackageReference Include="Quartz.Serialization.Json" Version="3.17.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

</Project>